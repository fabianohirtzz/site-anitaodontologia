# Site da Dra. Anita Nogiri na HostGator (Apache).

Options -Indexes
DirectoryIndex index.html index.php
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # HTTPS e domínio sem www, num único 301.
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^ https://anitaodontologia.com.br%{REQUEST_URI} [R=301,L]

  # Arquivos internos nunca servidos pela web.
  RewriteRule ^(lib|tests|tools|supabase|docs|partials|conteudo|data)(/|$) - [F,L]
  RewriteRule (^|/)config\.local(\.example)?\.php$ - [F,L]
  RewriteRule \.(md|py|sql|mjs)$ - [F,L]
</IfModule>

# Endereços do site antigo (PHP, levantados em 17/11/2026) para as páginas novas.
#   /index.php              -> /
#   /sobre                  -> /sobre.html
#   /procedimentos          -> /procedimentos.html
#   /galeria/consultorio    -> /sobre.html (fotos do consultório)
#   /galeria/procedimentos  -> /resultados.html
#   /contato e /agende      -> /contato.html
<IfModule mod_alias.c>
  RedirectMatch 301 ^/index\.php$ /
  RedirectMatch 301 ^/sobre/?$ /sobre.html
  RedirectMatch 301 ^/procedimentos/?$ /procedimentos.html
  RedirectMatch 301 ^/galeria/consultorio/?$ /sobre.html
  RedirectMatch 301 ^/galeria/procedimentos/?$ /resultados.html
  RedirectMatch 301 ^/galeria/?$ /resultados.html
  RedirectMatch 301 ^/contato/?$ /contato.html
  RedirectMatch 301 ^/agende/?$ /contato.html
</IfModule>

<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType image/svg+xml .svg
  AddType text/plain .txt
</IfModule>

# Cache: imagens e fontes por 1 ano (quando mudam, ganham ?v= no HTML).
# CSS e JS não são versionados: 1 hora, para uma publicação chegar logo.
# HTML sempre revalidado.
<IfModule mod_headers.c>
  <FilesMatch "\.(webp|png|jpe?g|svg|ico|woff2?)$">
    Header set Cache-Control "public, max-age=31536000"
  </FilesMatch>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=3600"
  </FilesMatch>
  <FilesMatch "\.(html|xml|txt)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
